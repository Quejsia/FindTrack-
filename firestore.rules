rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global utility primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validates item properties, checking types, boundaries, and formats
    function isValidItem(data) {
      return data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && (data.type == 'lost' || data.type == 'found')
        && data.title is string && data.title.size() <= 100
        && data.description is string && data.description.size() <= 1000
        && (data.category in ['electronics', 'keys', 'wallet', 'documents', 'clothing', 'jewelry', 'bags', 'others'])
        && data.location is string && data.location.size() <= 200
        && (data.status == 'active' || data.status == 'resolved')
        && data.contactName is string && data.contactName.size() <= 100
        && data.contactInfo is string && data.contactInfo.size() <= 200
        && data.date is string && data.date.size() <= 100
        && data.get('imageUrl', '') is string && data.get('imageUrl', '').size() <= 500000;
    }

    // Validates potential match parameters, enforcing score limits
    function isValidMatch(data) {
      return data.id is string && isValidId(data.id)
        && data.lostItemId is string && isValidId(data.lostItemId)
        && data.foundItemId is string && isValidId(data.foundItemId)
        && (data.confidenceScore is int || data.confidenceScore is float)
        && data.confidenceScore >= 0 && data.confidenceScore <= 100
        && data.matchReason is string && data.matchReason.size() <= 1000
        && (data.status == 'pending' || data.status == 'accepted' || data.status == 'rejected');
    }

    // --- Items Collection Rules ---
    match /items/{itemId} {
      // Enforce strict user data isolation on read/list
      allow read, list: if isSignedIn()
        && isEmailVerified()
        && existing().userId == request.auth.uid;

      // Creating a new item
      allow create: if isSignedIn()
        && isEmailVerified()
        && isValidId(itemId)
        && itemId == incoming().id
        && isValidItem(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Updating item details
      allow update: if isSignedIn()
        && isEmailVerified()
        && isValidId(itemId)
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isValidItem(incoming())
        && (
          // Limit actual client modifications to expected functional fields
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'location', 'status', 'contactName', 'contactInfo', 'date', 'imageUrl', 'updatedAt'])
        );

      // Deleting item entries
      allow delete: if isSignedIn()
        && isEmailVerified()
        && existing().userId == request.auth.uid;
    }

    // --- Matches Collection Rules ---
    match /matches/{matchId} {
      // Disallow broad list queries globally to prevent data scraping or cost-attacks
      allow list: if false;

      // Single match retrieval
      allow get: if isSignedIn()
        && isEmailVerified()
        && (
          get(/databases/$(database)/documents/items/$(existing().lostItemId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/items/$(existing().foundItemId)).data.userId == request.auth.uid
        );

      // Registering a potential matched connection
      allow create: if isSignedIn()
        && isEmailVerified()
        && isValidId(matchId)
        && matchId == incoming().id
        && isValidMatch(incoming())
        && (
          get(/databases/$(database)/documents/items/$(incoming().lostItemId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/items/$(incoming().foundItemId)).data.userId == request.auth.uid
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Accepting or rejecting a match
      allow update: if isSignedIn()
        && isEmailVerified()
        && isValidId(matchId)
        && (
          get(/databases/$(database)/documents/items/$(existing().lostItemId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/items/$(existing().foundItemId)).data.userId == request.auth.uid
        )
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isValidMatch(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn()
        && isEmailVerified()
        && (
          get(/databases/$(database)/documents/items/$(existing().lostItemId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/items/$(existing().foundItemId)).data.userId == request.auth.uid
        );
    }
  }
}
